<mxfile host="app.diagrams.net"><diagram id="page0" name="定位系統整體流程"><mxGraphModel dx="1280" dy="720" page="1" pageWidth="1280" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="定位系統整體流程" style="text;html=0;fontFamily=標楷體;fontSize=39;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1190" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="4D-GWO 位於設備定位端，螺絲定位融合保持獨立" style="text;html=0;fontFamily=標楷體;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="81" width="1190" height="32" as="geometry"/></mxCell><mxCell id="start" value="MQTT 作業開始，取得對應 ACK" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#F1F5FC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="395" y="130" width="490" height="58" as="geometry"/></mxCell><mxCell id="img" value="RGB-D 影像與逐幀 metadata" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="212" width="300" height="80" as="geometry"/></mxCell><mxCell id="sync" value="同幀驗證與螺絲辨識&#xa;深度反投影：相機座標" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="350" width="300" height="85" as="geometry"/></mxCell><mxCell id="raw" value="8 站 UWB 距離＋IMU&#xa;MQTT 原始量測" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="465" y="212" width="350" height="80" as="geometry"/></mxCell><mxCell id="pose" value="選定設備定位演算法&#xa;4D-GWO 位置＋IMU 姿態" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#F1F5FC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="465" y="350" width="350" height="85" as="geometry"/></mxCell><mxCell id="rtsp" value="RTSP 雙通道&#xa;彩色／深度預覽與錄影" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="925" y="212" width="310" height="80" as="geometry"/></mxCell><mxCell id="world" value="同時刻設備 pose＋相機外參&#xa;世界座標、Hungarian 關聯、螺絲融合" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="260" y="492" width="555" height="72" as="geometry"/></mxCell><mxCell id="db" value="資料庫與逐幀檔案&#xa;即時顯示／歷史回放" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="925" y="492" width="310" height="72" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="188" as="sourcePoint"/><mxPoint x="195" y="212" as="targetPoint"/><Array as="points"><mxPoint x="640" y="200"/><mxPoint x="195" y="200"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="188" as="sourcePoint"/><mxPoint x="640" y="212" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="188" as="sourcePoint"/><mxPoint x="1080" y="212" as="targetPoint"/><Array as="points"><mxPoint x="640" y="200"/><mxPoint x="1080" y="200"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="195" y="292" as="sourcePoint"/><mxPoint x="195" y="350" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="292" as="sourcePoint"/><mxPoint x="640" y="350" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="195" y="435" as="sourcePoint"/><mxPoint x="260" y="528" as="targetPoint"/><Array as="points"><mxPoint x="195" y="528"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="435" as="sourcePoint"/><mxPoint x="640" y="492" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e7" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815" y="528" as="sourcePoint"/><mxPoint x="925" y="528" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="292" as="sourcePoint"/><mxPoint x="1080" y="492" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label8" value="預覽與影片" style="text;html=0;fontFamily=標楷體;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1090" y="370" width="150" height="28" as="geometry"/></mxCell><mxCell id="t0" value="平台呈現：彩色／深度、bbox、3D 設備軌跡、螺絲位置與附近提示。&#xa;同幀定位走 RGB-D 封包，RTSP 不作同步依據。&#xa;目前深度與偵測含模擬資料，真實硬體與模型待接入。" style="text;html=0;fontFamily=標楷體;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="590" width="1190" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page1" name="同幀 RGB-D 接收與品質判斷"><mxGraphModel dx="1280" dy="720" page="1" pageWidth="1280" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="同幀 RGB-D 接收與品質判斷" style="text;html=0;fontFamily=標楷體;fontSize=39;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1190" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="以 frameId 與擷取時間配對，異常幀不強行更新螺絲位置" style="text;html=0;fontFamily=標楷體;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="81" width="1190" height="32" as="geometry"/></mxCell><mxCell id="packet" value="RGB-D 封包&#xa;JPEG＋PNG16＋frameId" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="130" width="345" height="80" as="geometry"/></mxCell><mxCell id="sequence" value="檢查封包、序號與時間&#xa;記錄跳號數" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="280" width="345" height="85" as="geometry"/></mxCell><mxCell id="time" value="彩色／深度擷取時間差&#xa;≤ 20 ms？" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#F1F5FC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="280" width="350" height="85" as="geometry"/></mxCell><mxCell id="bad" value="不更新定位&#xa;保存異常狀態與可用資料" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="280" width="350" height="85" as="geometry"/></mxCell><mxCell id="pose" value="PoseBuffer 依擷取時間取 pose&#xa;精確對應或前後插值" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="130" width="350" height="80" as="geometry"/></mxCell><mxCell id="detect" value="彩色辨識＋同幀深度&#xa;計算相機三維座標" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="445" width="350" height="85" as="geometry"/></mxCell><mxCell id="world" value="pose、深度與外參有效&#xa;才形成世界座標觀測" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="445" width="350" height="85" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="217" y="210" as="sourcePoint"/><mxPoint x="217" y="280" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="322" as="sourcePoint"/><mxPoint x="455" y="322" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="322" as="sourcePoint"/><mxPoint x="880" y="322" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label2" value="否" style="text;html=0;fontFamily=標楷體;fontSize=20;" vertex="1" parent="1"><mxGeometry x="825" y="288" width="45" height="28" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="365" as="sourcePoint"/><mxPoint x="630" y="445" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label3" value="是" style="text;html=0;fontFamily=標楷體;fontSize=20;" vertex="1" parent="1"><mxGeometry x="644" y="388" width="45" height="28" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="210" as="sourcePoint"/><mxPoint x="740" y="445" as="targetPoint"/><Array as="points"><mxPoint x="835" y="210"/><mxPoint x="835" y="410"/><mxPoint x="740" y="410"/></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="488" as="sourcePoint"/><mxPoint x="880" y="488" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="t0" value="跳號：計數，不借用其他幀&#xa;重複／倒序：拒絕&#xa;缺 pose：不外插" style="text;html=0;fontFamily=標楷體;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="440" width="345" height="100" as="geometry"/></mxCell><mxCell id="t1" value="Pose 插值：位置線性插值、四元數 SLERP，前後樣本間隔 ≤ 200 ms。&#xa;奈秒時間戳使用字串傳輸，並核對 sessionId、clockId 與 calibrationId。" style="text;html=0;fontFamily=標楷體;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="592" width="1185" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="4D-GWO 設備定位流程"><mxGraphModel dx="1280" dy="720" page="1" pageWidth="1280" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="4D-GWO 設備定位流程" style="text;html=0;fontFamily=標楷體;fontSize=39;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1190" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="UWB 求位置與共同距離偏差，IMU 管線提供設備姿態" style="text;html=0;fontFamily=標楷體;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="81" width="1190" height="32" as="geometry"/></mxCell><mxCell id="uwb" value="8 站原始 UWB 距離&#xa;MQTT 接收並保存" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="125" width="340" height="75" as="geometry"/></mxCell><mxCell id="check" value="去重、正值與有效站數&#xa;至少 5 站，幾何有效" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="260" width="340" height="85" as="geometry"/></mxCell><mxCell id="solve" value="4D-GWO 求解&#xa;x、y、z、共同偏差 b" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#F1F5FC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="260" width="350" height="85" as="geometry"/></mxCell><mxCell id="imu" value="IMU 角速度／姿態管線&#xa;MQTT 接收並保存" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="125" width="350" height="75" as="geometry"/></mxCell><mxCell id="attitude" value="四元數姿態 q&#xa;沿用既有 IMU 處理" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="260" width="350" height="85" as="geometry"/></mxCell><mxCell id="pose" value="設備 pose＝位置 p＋姿態 q&#xa;附時間戳與 b 診斷資料" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="465" width="350" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="200" as="sourcePoint"/><mxPoint x="215" y="260" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="302" as="sourcePoint"/><mxPoint x="455" y="302" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="200" as="sourcePoint"/><mxPoint x="1055" y="260" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="345" as="sourcePoint"/><mxPoint x="630" y="465" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="345" as="sourcePoint"/><mxPoint x="805" y="505" as="targetPoint"/><Array as="points"><mxPoint x="1055" y="505"/></Array></mxGeometry></mxCell><mxCell id="t0" value="min Σᵢ (‖p − aᵢ‖ + b − dᵢ)²&#xa;&#xa;p：設備位置&#xa;aᵢ：基站位置&#xa;dᵢ：原始距離" style="text;html=0;fontFamily=標楷體;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="410" width="340" height="160" as="geometry"/></mxCell><mxCell id="t1" value="資料不足或幾何退化&#xa;不產生新的有效位置" style="text;html=0;fontFamily=標楷體;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="850" y="570" width="380" height="85" as="geometry"/></mxCell><mxCell id="t2" value="100 隻狼 × 100 次迭代，b 預設 0～0.6 m。" style="text;html=0;fontFamily=標楷體;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="615" width="770" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="螺絲定位、關聯與多幀融合"><mxGraphModel dx="1280" dy="720" page="1" pageWidth="1280" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="螺絲定位、關聯與多幀融合" style="text;html=0;fontFamily=標楷體;fontSize=39;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1190" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="設備定位結果與同幀 RGB-D 觀測共同決定螺絲世界位置" style="text;html=0;fontFamily=標楷體;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="81" width="1190" height="32" as="geometry"/></mxCell><mxCell id="obs" value="bbox 中心＋同幀深度&#xa;內參反投影為相機座標" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="130" width="340" height="82" as="geometry"/></mxCell><mxCell id="world" value="設備 pose＋相機外參&#xa;轉換為原始世界座標" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#F1F5FC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="130" width="350" height="82" as="geometry"/></mxCell><mxCell id="map" value="既知螺絲地圖&#xa;位置與螺絲種類" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="350" height="82" as="geometry"/></mxCell><mxCell id="assoc" value="Hungarian 一對一關聯&#xa;類別限制＋距離 ≤ 0.8 m" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="300" width="350" height="85" as="geometry"/></mxCell><mxCell id="reject" value="未配對觀測&#xa;保留標記，不更新地圖" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="350" height="85" as="geometry"/></mxCell><mxCell id="fusion" value="每顆螺絲最近 60 筆觀測&#xa;多幀融合與不確定度" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="455" y="475" width="350" height="85" as="geometry"/></mxCell><mxCell id="out" value="保存融合位置與 bbox&#xa;平台選擇融合結果顯示" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=標楷體;fontSize=23;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="475" width="350" height="85" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="171" as="sourcePoint"/><mxPoint x="455" y="171" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;html=0;rounded=0;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="212" as="sourcePoint"/><mxPoint x="630" y="300" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;htm